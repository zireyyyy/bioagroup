{
  "name": "bioagroup-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/verify-source-bundle.mjs && node --import ./tools/net-guard.mjs build.mjs",
    "source:prepare": "node tools/prepare-source-bundle.mjs",
    "source:verify": "node tools/verify-source-bundle.mjs",
    "test:p0a": "node --test tests/p0a-source-pin.test.mjs tests/p0a-module-isolation.test.mjs && node tests/p0a-final-gate.mjs && node tests/p0a-determinism.mjs",
    "test:p0a:historical": "node tests/p0a-fidelity-allowlist.mjs",
    "test:candidate": "node --test tests/p0a-source-pin.test.mjs tests/p0a-module-isolation.test.mjs tests/serve-dist.test.mjs tests/chat-gateway.test.mjs && node tests/p0a-determinism.mjs && node tests/p1p2-icon-tablet-type.mjs && node tests/p3-static-site-audit.mjs && node tests/d11-legacy-redirects.mjs && node tests/business-identity.mjs",
    "test:smoke": "node tests/recovery-visual-smoke.mjs",
    "serve": "node tools/serve-dist.mjs 4173",
    "test:p0b1": "node tests/p0b1-runtime-pin.mjs",
    "test:turnstile": "node --test tests/lead-turnstile.test.mjs",
    "test:404": "node --test tests/not-found.test.mjs",
    "test:responsive": "node --test tests/tablet-header-compact.test.mjs tests/tablet-desktop-fluid.test.mjs tests/tablet-source-regression.test.mjs tests/tablet-type-email-regression.test.mjs tests/tablet-cross-route-regression.test.mjs tests/tablet-footer-merywood-flex.test.mjs tests/tablet-cta-reveal-and-layout.test.mjs tests/source-component-rebuild-contract.test.mjs tests/tablet-desktop-scale-contract.test.mjs tests/tablet-owned-shell-visual.test.mjs",
    "test:chat": "node --test tests/chat-gateway.test.mjs",
    "handoff:zip": "node tools/make-handoff-zip.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cheerio": "1.0.0",
    "jquery": "3.7.1",
    "smooth-scrollbar": "8.8.4",
    "swiper": "11.1.4"
  }
}
